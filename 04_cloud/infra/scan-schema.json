{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlantScanRecord",
  "description": "Schema for synchronized crop disease diagnosis scans",
  "type": "object",
  "required": [
    "scanId",
    "selectedCrop",
    "cropMode",
    "predictedCrop",
    "predictedClass",
    "displayName",
    "confidence",
    "createdAt"
  ],
  "properties": {
    "scanId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "selectedCrop": {
      "type": "string",
      "enum": [
        "apple",
        "blueberry",
        "cherry",
        "corn",
        "grape",
        "orange",
        "peach",
        "bell_pepper",
        "potato",
        "raspberry",
        "soybean",
        "squash",
        "strawberry",
        "tomato",
        "unknown"
      ]
    },
    "cropMode": {
      "type": "string",
      "enum": [
        "known",
        "unknown"
      ]
    },
    "predictedCrop": {
      "type": "string",
      "enum": [
        "apple",
        "blueberry",
        "cherry",
        "corn",
        "grape",
        "orange",
        "peach",
        "bell_pepper",
        "potato",
        "raspberry",
        "soybean",
        "squash",
        "strawberry",
        "tomato"
      ]
    },
    "predictedClass": {
      "type": "string",
      "enum": [
        "apple__apple_scab",
        "apple__black_rot",
        "apple__cedar_apple_rust",
        "apple__healthy",
        "bell_pepper__bacterial_spot",
        "bell_pepper__healthy",
        "blueberry__healthy",
        "cherry__healthy",
        "cherry__powdery_mildew",
        "corn__common_rust",
        "corn__gray_leaf_spot",
        "corn__healthy",
        "corn__northern_leaf_blight",
        "grape__black_rot",
        "grape__esca",
        "grape__healthy",
        "grape__leaf_blight_isariopsis",
        "orange__citrus_greening",
        "peach__bacterial_spot",
        "peach__healthy",
        "potato__early_blight",
        "potato__healthy",
        "potato__late_blight",
        "raspberry__healthy",
        "soybean__healthy",
        "squash__powdery_mildew",
        "strawberry__healthy",
        "strawberry__leaf_scorch",
        "tomato__bacterial_spot",
        "tomato__early_blight",
        "tomato__healthy",
        "tomato__late_blight",
        "tomato__leaf_mold",
        "tomato__mosaic_virus",
        "tomato__septoria_leaf_spot",
        "tomato__target_spot",
        "tomato__two_spotted_spider_mite",
        "tomato__yellow_leaf_curl_virus"
      ]
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "belowThreshold": {
      "type": "boolean"
    },
    "secondCandidate": {
      "type": [
        "object",
        "null"
      ]
    },
    "latencyMs": {
      "type": "number"
    },
    "modelVersion": {
      "type": "string"
    },
    "taxonomyVersion": {
      "type": "string"
    },
    "weatherSnapshot": {
      "type": "object",
      "required": [
        "temperatureC",
        "humidityPct",
        "rainMm",
        "source",
        "sourceLabel"
      ],
      "properties": {
        "temperatureC": {
          "type": "number"
        },
        "humidityPct": {
          "type": "number"
        },
        "rainMm": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "enum": [
            "live",
            "cache",
            "fallback"
          ]
        },
        "sourceLabel": {
          "type": "string"
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "score",
        "category"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "notAssessed": {
          "type": "boolean"
        },
        "isApproximate": {
          "type": "boolean"
        }
      }
    },
    "imageMeta": {
      "type": "object",
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "originalBytes": { "type": "number" },
        "format": { "type": "string" },
        "exifOriented": { "type": "boolean" },
        "blurVariance": { "type": "number" },
        "brightness": { "type": "number" },
        "exgIndex": { "type": "number" }
      }
    },
    "cropStage": {
      "type": "string"
    },
    "manualWeather": {
      "type": "object"
    },
    "forecastSnapshot": {
      "type": "object"
    },
    "outlook": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "headline": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "advisory": {
      "type": "object",
      "properties": {
        "actionHeadline": { "type": "string" },
        "bestWindow": { "type": "string" },
        "outlookLine": { "type": "string" },
        "timing": { "type": "array" },
        "nutritionTips": { "type": "array" },
        "disclaimers": { "type": "array" }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}