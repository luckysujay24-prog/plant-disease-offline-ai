# ==============================================================================
# Environment Configuration Template
# Offline-First Plant Disease Detection Framework
# ==============================================================================
# Copy this file to .env in 03_app/ or root as needed. Never commit .env.

# --- AWS Cloud Integration (Optional / Non-blocking) ---
# AWS region where SAM template resources are deployed
VITE_AWS_REGION=
# Cognito User Pool ID (e.g., ap-south-1_xxxxxxxxx)
VITE_USER_POOL_ID=
# Cognito User Pool App Client ID (no client secret)
VITE_USER_POOL_CLIENT_ID=
# API Gateway HTTP API endpoint URL (e.g., https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com)
VITE_API_BASE_URL=

# --- Mock Server Integration ---
# Set to 'true' to route app sync requests to the local mock server during development/testing
VITE_USE_MOCK_API=false
# Port for the local mock server (04_cloud/mock-server)
MOCK_SERVER_PORT=4000

# --- Weather API Configuration ---
# Open-Meteo forecast API base URL (free tier, no API key required)
VITE_WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
# Timeout in milliseconds for live weather API requests (default: 5000)
VITE_WEATHER_API_TIMEOUT_MS=5000

# --- ML Training & Seed Configuration ---
GLOBAL_RANDOM_SEED=42
